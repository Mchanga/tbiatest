{
  "name": "tbia-backend",
  "version": "1.0.0",
  "description": "Tanzania Business & Investment Awards Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:watch": "vitest",
    "test:auth-smoke": "set TBIA_CONFIRM_DB_WRITE=1&& vitest run tests/backend.test.ts -t \"auth smoke integration\"",
    "test:email-e2e": "set TBIA_CONFIRM_EMAIL_SEND=1&& vitest run tests/backend.test.ts -t \"email E2E integration\"",
    "seed:permissions": "tsx scripts/seed-permissions.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admins.ts",
    "db:migrate": "tsx scripts/migrations/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
